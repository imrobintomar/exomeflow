# ============================================================
# ExomeFlow — LOCAL BUILD (private, do NOT push to Docker Hub)
#
# Bundles GATK 4.6.2.0 and ANNOVAR scripts from your local Exomeflow folder.
# Only the ANNOVAR humandb (large databases) must be mounted at runtime.
#
# ── Prerequisites ────────────────────────────────────────────
#   Exomeflow/
#   ├── gatk-4.6.2.0/      ← local GATK installation
#   └── annovar/           ← ANNOVAR Perl scripts (no humandb)
#
# ── Build ────────────────────────────────────────────────────
#   docker build -f Dockerfile.local -t exomeflow-local:2.1.1 .
#
# ── Run ─────────────────────────────────────────────────────
#   docker run --rm -it \
#     -v /path/to/fastq:/data/fastq \
#     -v /path/to/refs:/refs \
#     -v /path/to/vcf:/vcf \
#     -v /path/to/annovar/humandb:/annovar/humandb \
#     -v /path/to/results:/data/results \
#     exomeflow-local:2.1.1 run \
#       --input-dir    /data/fastq \
#       --output       /data/results \
#       --reference    /refs/Homo_sapiens_assembly38.fasta \
#       --dbsnp        /vcf/Homo_sapiens_assembly38.dbsnp138.vcf.gz \
#       --mills        /vcf/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz \
#       --known-indels /vcf/Homo_sapiens_assembly38.known_indels.vcf.gz \
#       --annovar-bin  /annovar \
#       --annovar-db   /annovar/humandb \
#       --threads      24
#
# ⚠  DO NOT push to Docker Hub — ANNOVAR license prohibits redistribution.
# ============================================================

FROM continuumio/miniconda3:24.1.2-0

LABEL maintainer="Robin Kumar <itsrobintomar@gmail.com>"
LABEL org.opencontainers.image.title="ExomeFlow (local build)"
LABEL org.opencontainers.image.description="ExomeFlow WES pipeline — private build with bundled GATK + ANNOVAR"
LABEL org.opencontainers.image.version="2.1.1"

# ── System packages + Java 17 ────────────────────────────────────────────────
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        perl \
        openjdk-17-jre-headless \
        libncurses5-dev \
        libbz2-dev \
        liblzma-dev \
        zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
ENV JAVA_OPTS="-Xmx80g"
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Conda channels ───────────────────────────────────────────────────────────
RUN conda config --add channels defaults && \
    conda config --add channels bioconda && \
    conda config --add channels conda-forge && \
    conda config --set channel_priority flexible

# ── Bioinformatics tools ─────────────────────────────────────────────────────
RUN conda install -y \
        "bwa>=0.7.17" \
        "samtools>=1.13" \
        "fastp>=0.20.1" \
        perl \
    && conda clean -afy

# ── GATK 4.6.2.0 from local build context ───────────────────────────────────
COPY gatk-4.6.2.0/ /gatk/
RUN chmod +x /gatk/gatk && ln -sf /gatk/gatk /usr/local/bin/gatk
ENV PATH="/gatk:${PATH}"

# ── ANNOVAR scripts from local build context ─────────────────────────────────
# Only Perl scripts are copied — humandb is mounted at runtime
COPY annovar/*.pl /annovar/
RUN chmod +x /annovar/*.pl
ENV PATH="/annovar:${PATH}"

# ── ExomeFlow ────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir exomeflow==2.1.1

# ── Verify ───────────────────────────────────────────────────────────────────
RUN gatk --version && \
    bwa 2>&1 | head -3 && \
    samtools --version | head -1 && \
    fastp --version 2>&1 | head -1 && \
    perl --version | head -2 && \
    perl /annovar/table_annovar.pl 2>&1 | head -3 && \
    exomeflow --version

# ── Volumes ──────────────────────────────────────────────────────────────────
# /data/fastq       — input FASTQ files
# /data/results     — pipeline output
# /refs             — reference FASTA + BWA index
# /vcf              — dbsnp138, Mills indels, known indels VCFs
# /annovar/humandb  — ANNOVAR databases (USER MUST MOUNT — too large to bundle)
VOLUME ["/data/fastq", "/data/results", "/refs", "/vcf", "/annovar/humandb"]

WORKDIR /data

ENTRYPOINT ["exomeflow"]
CMD ["--help"]
