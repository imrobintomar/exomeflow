# ============================================================
# ExomeFlow — LOCAL BUILD (includes ANNOVAR)
#
# This Dockerfile bundles ANNOVAR for private/research use only.
# DO NOT push this image to any public registry (Docker Hub, GHCR, etc.)
# ANNOVAR license prohibits redistribution:
#   https://annovar.openbioinformatics.org/en/latest/#license
#
# Prerequisites:
#   1. Download ANNOVAR from annovar.openbioinformatics.org
#   2. Place it in: /media/drprabudh/m2/Exomeflow/annovar/
#   3. Place databases in: /media/drprabudh/m2/Exomeflow/annovar/hg38_humandb/
#
# Build (private use only):
#   docker build -f Dockerfile.local -t exomeflow-local:1.0.6 .
#
# Run:
#   docker run --rm -it \
#     -v /path/to/fastq:/data/fastq \
#     -v /path/to/refs:/refs \
#     -v /path/to/results:/data/results \
#     exomeflow-local:1.0.6 run \
#       --input-dir   /data/fastq \
#       --output      /data/results \
#       --reference   /refs/hg38.fa \
#       --dbsnp       /refs/dbsnp.vcf.gz \
#       --mills       /refs/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz \
#       --known-indels /refs/Homo_sapiens_assembly38.known_indels.vcf.gz \
#       --annovar-bin /annovar \
#       --annovar-db  /annovar/hg38_humandb \
#       --threads     24
# ============================================================

FROM broadinstitute/gatk:4.6.2.0

LABEL maintainer="Robin Tomar <itsrobintomar@gmail.com>"
LABEL org.opencontainers.image.title="ExomeFlow (local build)"
LABEL org.opencontainers.image.description="ExomeFlow WES pipeline — private build with ANNOVAR"
LABEL org.opencontainers.image.version="1.0.6"

# ── System packages ──────────────────────────────────────────────────────────
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        perl \
        libncurses5-dev \
        libbz2-dev \
        liblzma-dev \
        zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Conda channels ───────────────────────────────────────────────────────────
RUN conda config --add channels defaults && \
    conda config --add channels bioconda && \
    conda config --add channels conda-forge && \
    conda config --set channel_priority flexible

# ── Bioinformatics tools ─────────────────────────────────────────────────────
RUN conda install -y \
        "bwa>=0.7.17" \
        "samtools>=1.13" \
        "fastp>=0.20.1" \
        perl \
    && conda clean -afy

# ── Java options ─────────────────────────────────────────────────────────────
ENV JAVA_OPTS="-Xmx80g"

# ── ExomeFlow Python package ─────────────────────────────────────────────────
RUN pip install --no-cache-dir exomeflow==1.0.6

# ── Copy ANNOVAR from local build context ────────────────────────────────────
# Requires: ./annovar/ directory present at build time
# Place your ANNOVAR installation at /media/drprabudh/m2/Exomeflow/annovar/
COPY annovar/ /annovar/
RUN chmod -R +x /annovar/*.pl 2>/dev/null || true

# Set ANNOVAR on PATH
ENV PATH="/annovar:${PATH}"

# ── Verify installation ──────────────────────────────────────────────────────
RUN echo "=== Verifying tools ===" && \
    gatk --version && \
    bwa 2>&1 | grep -i "version\|Program" | head -1 && \
    samtools --version | head -1 && \
    fastp --version 2>&1 | head -1 && \
    perl --version | head -1 && \
    perl /annovar/table_annovar.pl --help 2>&1 | head -2 && \
    exomeflow --version && \
    echo "=== All tools verified ==="

# ── Mount points ─────────────────────────────────────────────────────────────
# /data/fastq    — input FASTQ files
# /data/results  — pipeline output
# /refs          — reference genome + VCF files
VOLUME ["/data/fastq", "/data/results", "/refs"]

WORKDIR /data

ENTRYPOINT ["exomeflow"]
CMD ["--help"]
