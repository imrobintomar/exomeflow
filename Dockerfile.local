# ============================================================
# ExomeFlow — LOCAL BUILD
# Uses local GATK 4.6.2.0 and ANNOVAR source code
#
# GATK and ANNOVAR scripts are copied from the build context.
# Only the ANNOVAR humandb (big databases) needs to be mounted.
#
# Build:
#   docker build -f Dockerfile.local -t exomeflow-local:1.0.6 .
#
# Run:
#   docker run --rm -it \
#     -v /media/drprabudh/m2/ARM-PRJNA1344179/fastq:/data/fastq \
#     -v /media/drprabudh/m1/hg38:/refs \
#     -v /media/drprabudh/m1/vcf_file:/vcf \
#     -v /media/drprabudh/m1/annovar/hg38_humandb:/annovar/humandb \
#     -v /media/drprabudh/m2/results:/data/results \
#     exomeflow-local:1.0.6 run \
#       --input-dir    /data/fastq \
#       --output       /data/results \
#       --reference    /refs/hg38.fa \
#       --dbsnp        /vcf/dbsnp.vcf.gz \
#       --mills        /vcf/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz \
#       --known-indels /vcf/Homo_sapiens_assembly38.known_indels.vcf.gz \
#       --annovar-bin  /annovar \
#       --annovar-db   /annovar/humandb \
#       --threads      24
#
# NOTE: DO NOT push this image to Docker Hub or any public registry.
#       ANNOVAR license prohibits redistribution.
# ============================================================

FROM continuumio/miniconda3:24.1.2-0

LABEL maintainer="Robin Tomar <itsrobintomar@gmail.com>"
LABEL org.opencontainers.image.title="ExomeFlow (local build)"
LABEL org.opencontainers.image.description="ExomeFlow WES pipeline — private build with GATK + ANNOVAR"
LABEL org.opencontainers.image.version="1.0.6"

# ── System packages + Java 17 ────────────────────────────────────────────────
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        perl \
        openjdk-17-jre-headless \
        libncurses5-dev \
        libbz2-dev \
        liblzma-dev \
        zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
ENV JAVA_OPTS="-Xmx80g"
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Conda channels ───────────────────────────────────────────────────────────
RUN conda config --add channels defaults && \
    conda config --add channels bioconda && \
    conda config --add channels conda-forge && \
    conda config --set channel_priority flexible

# ── Bioinformatics tools via conda ───────────────────────────────────────────
RUN conda install -y \
        "bwa>=0.7.17" \
        "samtools>=1.13" \
        "fastp>=0.20.1" \
        perl \
    && conda clean -afy

# ── Copy GATK 4.6.2.0 from local build context ───────────────────────────────
COPY gatk-4.6.2.0/ /gatk/
RUN chmod +x /gatk/gatk && \
    ln -s /gatk/gatk /usr/local/bin/gatk
ENV PATH="/gatk:${PATH}"

# ── Copy ANNOVAR scripts from local build context ────────────────────────────
# humandb (big databases) is NOT copied — mount at runtime
# Only the Perl scripts are copied (~small)
COPY annovar/*.pl /annovar/
COPY annovar/retrieve_seq_from_fasta.pl /annovar/
RUN chmod +x /annovar/*.pl
ENV PATH="/annovar:${PATH}"

# ── ExomeFlow Python package ─────────────────────────────────────────────────
RUN pip install --no-cache-dir exomeflow==1.0.6

# ── Verify all tools ─────────────────────────────────────────────────────────
RUN echo "=== Verifying tools ===" && \
    gatk --version && \
    bwa 2>&1 | grep -i "version\|Program" | head -1 && \
    samtools --version | head -1 && \
    fastp --version 2>&1 | head -1 && \
    perl --version | head -1 && \
    perl /annovar/table_annovar.pl 2>&1 | head -3 && \
    exomeflow --version && \
    echo "=== All tools verified ==="

# ── Mount points ─────────────────────────────────────────────────────────────
# /data/fastq         — input FASTQ files
# /data/results       — pipeline output
# /refs               — hg38.fa + BWA index
# /vcf                — dbsnp.vcf.gz, mills.vcf.gz, known_indels.vcf.gz
# /annovar/humandb    — ANNOVAR databases (gnomAD, ClinVar, etc.)
VOLUME ["/data/fastq", "/data/results", "/refs", "/vcf", "/annovar/humandb"]

WORKDIR /data

ENTRYPOINT ["exomeflow"]
CMD ["--help"]
